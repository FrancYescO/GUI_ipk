# Reproducible seed for the package feed. `make defconfig` expands it against
# the buildroot snapshot before every build.
CONFIG_TARGET_brcm63xx_tch=y
CONFIG_TARGET_brcm63xx_tch_VBNTS=y
CONFIG_TARGET_brcm63xx_tch_VBNTS_Generic=y

# Build every package exposed by the archived feeds, including non-shared
# variants and kernel modules, matching the configuration in the snapshot.
CONFIG_ALL=y
CONFIG_ALL_KMODS=y
CONFIG_ALL_NONSHARED=y

# Scanner tools, network service and every backend supported by this target.
CONFIG_PACKAGE_libsane=m
CONFIG_PACKAGE_sane-backends=m
CONFIG_PACKAGE_sane-backends-all=m
CONFIG_PACKAGE_sane-frontends=m
CONFIG_PACKAGE_sane-daemon=m
CONFIG_PACKAGE_xinetd=m

CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_GCC_USE_VERSION_4_8_LINARO=y
CONFIG_LIBC_USE_GLIBC=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -march=armv7-a -mtune=cortex-a9 -mfpu=neon"
CONFIG_BINARY_FOLDER="$(TOPDIR)/bin/$(BOARD)/$(SUBTARGET)"

# Keep output deterministic and suitable for a package feed.
CONFIG_BUILD_LOG=y
# CONFIG_SIGNED_PACKAGES is not set
# CONFIG_SIGNATURE_CHECK is not set
