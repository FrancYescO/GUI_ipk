# Build supported userspace packages exposed by the archived feeds for VBNTS.
# `make defconfig` expands this seed against the buildroot snapshot.
CONFIG_TARGET_brcm63xx_tch=y
CONFIG_TARGET_brcm63xx_tch_VBNTS=y
CONFIG_TARGET_brcm63xx_tch_VBNTS_Generic=y

CONFIG_ALL=y
# CONFIG_ALL_KMODS is not set
CONFIG_ALL_NONSHARED=y

CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_GCC_USE_VERSION_4_8_LINARO=y
CONFIG_LIBC_USE_GLIBC=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -march=armv7-a -mtune=cortex-a9 -mfpu=neon"
CONFIG_BINARY_FOLDER="$(TOPDIR)/bin/$(BOARD)/$(SUBTARGET)"

CONFIG_BUILD_LOG=y
# CONFIG_SIGNED_PACKAGES is not set
# CONFIG_SIGNATURE_CHECK is not set

# The native compiler cannot bootstrap GCC 5's C++14 runtime with GCC 4.8.
# Keep the cross-toolchain and runtime libraries; exclude only the target compiler.
# CONFIG_PACKAGE_gcc is not set
