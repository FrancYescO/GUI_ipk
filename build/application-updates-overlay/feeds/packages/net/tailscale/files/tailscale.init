#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: BSD-3-Clause
USE_PROCD=1
START=80
STOP=20

start_service() {
	local enabled port tun
	config_load tailscale
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get port main port 41641
	config_get tun main tun tailscale0
	case "$port" in ''|*[!0-9]*) return 1 ;; esac
	[ "$port" -ge 0 ] && [ "$port" -le 65535 ] || return 1
	case "$tun" in ''|*[!a-zA-Z0-9_.-]*) return 1 ;; esac
	mkdir -p /etc/tailscale /var/run/tailscale
	chmod 700 /etc/tailscale /var/run/tailscale
	procd_open_instance
	procd_set_param command /usr/sbin/tailscaled \
		--state=/etc/tailscale/tailscaled.state \
		--socket=/var/run/tailscale/tailscaled.sock \
		--port="$port" --tun="$tun"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
service_triggers() {
	procd_add_reload_trigger tailscale
}
