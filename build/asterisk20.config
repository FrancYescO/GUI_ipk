# Experimental SIP/PJSIP-only Asterisk 20 profile for VBNTS.
# `make defconfig` expands this seed against the buildroot snapshot.
CONFIG_TARGET_brcm63xx_tch=y
CONFIG_TARGET_brcm63xx_tch_VBNTS=y
CONFIG_TARGET_brcm63xx_tch_VBNTS_Generic=y

# CONFIG_ALL is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set

CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_GCC_USE_VERSION_4_8_LINARO=y
CONFIG_LIBC_USE_GLIBC=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-O3 -pipe -march=armv7-a -mtune=cortex-a9 -mfpu=neon"
CONFIG_BINARY_FOLDER="$(TOPDIR)/bin/$(BOARD)/$(SUBTARGET)"

CONFIG_BUILD_LOG=y
# CONFIG_SIGNED_PACKAGES is not set
# CONFIG_SIGNATURE_CHECK is not set

# SIP, RTP and audio modules; package dependencies select required libraries.
CONFIG_PACKAGE_asterisk=m
CONFIG_PACKAGE_asterisk-pjsip=m
CONFIG_PACKAGE_asterisk-res-rtp-asterisk=m
CONFIG_PACKAGE_asterisk-res-pjproject=m
CONFIG_PACKAGE_asterisk-res-sorcery=m
CONFIG_PACKAGE_asterisk-bridge-simple=m
CONFIG_PACKAGE_asterisk-bridge-native-rtp=m
CONFIG_PACKAGE_asterisk-bridge-builtin-features=m
CONFIG_PACKAGE_asterisk-codec-alaw=m
CONFIG_PACKAGE_asterisk-codec-ulaw=m
CONFIG_PACKAGE_asterisk-codec-a-mu=m
CONFIG_PACKAGE_asterisk-codec-g722=m
CONFIG_PACKAGE_asterisk-format-wav=m
CONFIG_PACKAGE_asterisk-format-pcm=m
