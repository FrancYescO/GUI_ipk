#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

USE_PROCD=1
START=95
STOP=10

start_service() {
	local enabled port username password interface webroot
	config_load rclone
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || return 0
	config_get port main port 5572
	config_get username main username rclone
	config_get password main password
	if [ -z "$username" ] || [ -z "$password" ]; then
		logger -t rclone 'Set a username and password before enabling remote control'
		return 1
	fi
	case "$port" in ''|*[!0-9]*) return 1 ;; esac
	[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
	mkdir -p /etc/rclone
	touch /etc/rclone/rclone.conf
	chmod 700 /etc/rclone
	chmod 600 /etc/rclone/rclone.conf
	chown rclone:rclone /etc/rclone /etc/rclone/rclone.conf

	config_get interface main interface
	case "$interface" in
		'') webroot= ;;
		ng|react) webroot="/usr/share/rclone/$interface" ;;
		*) logger -t rclone 'Unknown web interface'; return 1 ;;
	esac
	if [ -n "$webroot" ] && [ ! -f "$webroot/index.html" ]; then
		logger -t rclone 'Install the selected web interface package first'
		return 1
	fi
	procd_open_instance
	procd_set_param command /usr/bin/rclone rcd \
		--config=/etc/rclone/rclone.conf \
		--rc-addr="127.0.0.1:$port" \
		--rc-user="$username" --rc-pass="$password"
	[ -z "$webroot" ] || procd_append_param command --rc-files="$webroot"
	procd_set_param user rclone
	procd_set_param group rclone
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger rclone
}
