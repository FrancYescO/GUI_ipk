@@ -4,0 +5,7 @@
+
+# Vendor kernels can expose the legacy swconfig UAPI regardless of version.
+# Use the same headers and flags as the actual objects; never invent wire IDs.
+SWCONFIG_LINK_API := $(shell printf '%s\n' '\#include <linux/switch.h>' 'int swconfig_link_api[] = { SWITCH_TYPE_LINK, SWITCH_ATTR_OP_VALUE_LINK, SWITCH_LINK_FLAG_TX_FLOW, SWITCH_LINK_FLAG_RX_FLOW };' | $(CC) $(CFLAGS) -x c -fsyntax-only - 2>/dev/null && echo 1)
+ifeq ($(SWCONFIG_LINK_API),1)
+CFLAGS += -DSWCONFIG_HAS_LINK_API
+endif
