--- a/package/network/config/swconfig/Makefile
+++ b/package/network/config/swconfig/Makefile
@@ -23,8 +23,17 @@
   TITLE:=Switch configuration utility
 endef
 
+# Keep the kernel's actual switch UAPI values. Older vendor headers do not
+# implement the structured link attribute, so only expose it when all of the
+# required identifiers are available.
+SWCONFIG_HAS_LINK := $(shell \
+	grep -q SWITCH_ATTR_OP_VALUE_LINK $(LINUX_DIR)/user_headers/include/linux/switch.h 2>/dev/null && \
+	grep -q SWITCH_TYPE_LINK $(LINUX_DIR)/user_headers/include/linux/switch.h 2>/dev/null && \
+	grep -q SWITCH_LINK_FLAG_RX_FLOW $(LINUX_DIR)/user_headers/include/linux/switch.h 2>/dev/null && echo 1)
+
 TARGET_CPPFLAGS := \
 	-D_GNU_SOURCE \
+	$(if $(SWCONFIG_HAS_LINK),-DSWCONFIG_HAS_LINK) \
 	-I$(STAGING_DIR)/usr/include/libnl-tiny \
 	-I$(PKG_BUILD_DIR) \
 	$(TARGET_CPPFLAGS) \
