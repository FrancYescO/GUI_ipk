+/* GCC 4.8 does not expose the mode macros used by GCC 5's libgcc.
+   The ARM bootstrap compiler still provides IEEE single and double modes. */
+#if defined (__arm__) && __GNUC__ == 4 && __GNUC_MINOR__ < 9
+#ifndef __LIBGCC_HAS_SF_MODE__
+#define __LIBGCC_HAS_SF_MODE__ 1
+#define __LIBGCC_SF_MANT_DIG__ __FLT_MANT_DIG__
+#define __LIBGCC_SF_FUNC_EXT__ f
+#define __LIBGCC_SF_EXCESS_PRECISION__ 0
+#endif
+#ifndef __LIBGCC_HAS_DF_MODE__
+#define __LIBGCC_HAS_DF_MODE__ 1
+#define __LIBGCC_DF_MANT_DIG__ __DBL_MANT_DIG__
+#define __LIBGCC_DF_FUNC_EXT__
+#define __LIBGCC_DF_EXCESS_PRECISION__ 0
+#endif
+#endif
 
 #ifdef __LIBGCC_HAS_SF_MODE__
 #define LIBGCC2_HAS_SF_MODE 1
