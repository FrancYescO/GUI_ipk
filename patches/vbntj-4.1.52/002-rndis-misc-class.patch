Subject: [PATCH] usbnet: recognize miscellaneous-class RNDIS in both host and CDC parser

Backport USB class ef/04/01 matching from modern Linux. Updating only the
RNDIS match table still sends this interface through the CDC Ethernet
validation path, which rejects its valid RNDIS descriptors.

Reference implementations:
https://github.com/torvalds/linux/blob/v6.1/drivers/net/usb/cdc_ether.c
https://github.com/torvalds/linux/blob/v6.6/drivers/net/usb/rndis_host.c

--- a/drivers/net/usb/cdc_ether.c
+++ b/drivers/net/usb/cdc_ether.c
@@ -54,11 +54,20 @@
 		desc->bInterfaceProtocol == 3);
 }
 
+/* RNDIS over Ethernet, supported by newer USB composite devices. */
+static int is_misc_rndis(struct usb_interface_descriptor *desc)
+{
+	return (desc->bInterfaceClass == USB_CLASS_MISC &&
+		desc->bInterfaceSubClass == 4 &&
+		desc->bInterfaceProtocol == 1);
+}
+
 #else
 
 #define is_rndis(desc)		0
 #define is_activesync(desc)	0
 #define is_wireless_rndis(desc)	0
+#define is_misc_rndis(desc)	0
 
 #endif
 
@@ -151,7 +160,8 @@
 	 */
 	rndis = (is_rndis(&intf->cur_altsetting->desc) ||
 		 is_activesync(&intf->cur_altsetting->desc) ||
-		 is_wireless_rndis(&intf->cur_altsetting->desc));
+		 is_wireless_rndis(&intf->cur_altsetting->desc) ||
+		 is_misc_rndis(&intf->cur_altsetting->desc));
 
 	memset(info, 0, sizeof(*info));
 	info->control = intf;
--- a/drivers/net/usb/rndis_host.c
+++ b/drivers/net/usb/rndis_host.c
@@ -627,6 +627,10 @@
 	/* RNDIS for tethering */
 	USB_INTERFACE_INFO(USB_CLASS_WIRELESS_CONTROLLER, 1, 3),
 	.driver_info = (unsigned long) &rndis_info,
+}, {
+	/* RNDIS over Ethernet (USB miscellaneous class). */
+	USB_INTERFACE_INFO(USB_CLASS_MISC, 4, 1),
+	.driver_info = (unsigned long) &rndis_info,
 },
 	{ },		// END
 };
