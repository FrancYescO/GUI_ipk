+static int spu_lab_fallback(struct spu_ctx *ctx, void *req, bool encrypt)
+{
+    int err;
+    atomic_inc(&lab_pool_fallback_uses);
+    /* The existing fallback provider excludes ASYNC and NEED_FALLBACK. */
+    err = spu_aead_do_fallback_cipher(ctx->fallback_cipher, req, encrypt);
+    if (encrypt) {
+        if (!err || err == -EINPROGRESS) spuinfo->stats.encFallback++;
+        else spuinfo->stats.encDrops++;
+        if (!err) spuinfo->stats.encSpuEgress++;
+    } else {
+        if (!err || err == -EINPROGRESS) spuinfo->stats.decFallback++;
+        else spuinfo->stats.decDrops++;
+        if (!err) spuinfo->stats.decSpuEgress++;
+    }
+    return err;
+}
